<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>FinBooKeApp.Core</RootNamespace>
    <AssemblyName>FinBooKeApp.Core</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Update="Resources/EmailText.resx">
      <Generator>MSBuild:Compile</Generator>
      <StronglyTypedFileName>Resources/EmailText.cs</StronglyTypedFileName>
      <StronglyTypedLanguage>CSharp</StronglyTypedLanguage>
      <StronglyTypedNamespace>FinBooKeApp.Core</StronglyTypedNamespace>
      <StronglyTypedClassName>EmailText</StronglyTypedClassName> 
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Localization" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FinBooKeApp.Data\FinBooKeApp.Data.csproj" />
  </ItemGroup>

</Project>
